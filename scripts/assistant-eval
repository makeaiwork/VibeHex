#!/usr/bin/env bash
set -euo pipefail

# Opt-in live eval of Assistant's replies; never part of scripts/check or CI.
#
# Asks a real engine every question in tests/fixtures/assistant/questions.jsonl,
# then guided setup (its four questions, the follow-ups, then a plan for fixed
# answers) and a vocabulary request, through the same path the pane takes: the
# prompt, the reply, the parse, and the repair round for a remote engine. It
# prints one line per reply and writes a JSON report: the cards each made, what
# was refused, and the expected changes it missed.
#
# A remote engine is paid per request: choose one on purpose.
#
#   HEX_ASSISTANT_EVAL_ENGINE   codex | codex:<model> | local:<id> | openrouter | custom | opencode
#                               (required; read with your own VibeHex settings and sign-ins)
#   HEX_ASSISTANT_EVAL_EFFORT   Codex reasoning effort, low by default
#   HEX_ASSISTANT_EVAL_LIMIT    ask only the first N guide questions (setup and vocabulary always run)
#   HEX_ASSISTANT_EVAL_OUT      the report's path, $TMPDIR/assistant-eval.json by default
#
# Example: HEX_ASSISTANT_EVAL_ENGINE=local:qwen3-4b HEX_ASSISTANT_EVAL_LIMIT=10 scripts/assistant-eval

if [[ -z "${HEX_ASSISTANT_EVAL_ENGINE:-}" ]]; then
  sed -n '3,22p' "$0" | sed 's/^# \{0,1\}//' >&2
  echo >&2
  echo "error: set HEX_ASSISTANT_EVAL_ENGINE to choose the engine to ask" >&2
  exit 2
fi

cd "$(dirname "$0")/.."
exec cargo test --locked --bin hex assistant::eval::evaluate_assistant_replies \
  -- --ignored --nocapture --test-threads=1
