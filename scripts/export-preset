#!/usr/bin/env -S python3 -I
"""Exports a VibeHex settings.json as a setup preset ("Set me up like Denis").

    python3 -I scripts/export-preset [settings.json] [preset.json]

Reads ~/Library/Application Support/hex/settings.json by default and writes
presets/deniskey.json, which the app ships (`assistant::setup::preset`).

It is an allow-list: it walks the `hex settings` registry (the keys
src/control/settings.rs and src/control/settings/*.rs declare) and keeps only
the keys ALLOWED names, then the Global mode's cleanup switch and prompt and
the Vocabulary. Nothing else leaves the file: no API keys or other secrets,
server addresses, folders or paths, microphone, calendars, window or update
state, Assistant's own settings, app lists or browser hosts. DENIED is checked
on top of the allow-list, so a key added to ALLOWED by mistake still can't
carry one of those out.
"""

import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
DEFAULT_SETTINGS = pathlib.Path.home() / "Library/Application Support/hex/settings.json"
DEFAULT_OUT = ROOT / "presets/deniskey.json"

# Registry keys a preset carries, besides every Labs on/off switch.
ALLOWED = {
    # Speech model and language.
    "transcription.model",
    "transcription.language",
    # Dictation cleanup.
    "dictation_processing.server.runs_on",
    "dictation_processing.server.local_model",
    "dictation_processing.server.codex_model",
    "dictation_processing.server.codex_effort",
    # Meetings: engines, writer, effort, toggles, retention.
    "meetings.enabled",
    "meetings.summaries",
    "meetings.notes.writer",
    "meetings.notes.effort",
    "meetings.questions.enabled",
    "meetings.questions.engine",
    "meetings.questions.effort",
    "meetings.show_recording_indicator",
    "meetings.retention",
    # Files: engines, efforts, toggles.
    "files.transcription",
    "files.language",
    "files.use_vocabulary",
    "files.show_timestamps",
    "files.cleanup_after",
    "files.cleanup_engine",
    "files.cleanup_effort",
    "files.request_engine",
    "files.request_effort",
    "files.use_default_prompt",
}

# How the shortcuts work, offered with them in the second step.
SHORTCUT_MODES = {"shortcut_mode", "double_tap_lock", "double_tap_only"}

# Labs switches that are window state, not a feature.
LABS_STATE = {"labs.sidebar_collapsed"}

# Never in a preset, whatever ALLOWED says.
DENIED = re.compile(
    r"api_?key|apikey|token|secret|password|url|host|folder|path|microphone|device"
    r"|calendar|sidebar_collapsed|last_folder|recents|onboarding|migrations"
    r"|^updates\.|^assistant\.|applications|browser_hosts|providers|^capture\.routing",
    re.IGNORECASE,
)

KEY_CALL = re.compile(
    r"\b(?:key|optional|read_only)\(\s*\"([a-z_.]+)\",\s*(Kind::(\w+)|[A-Z_]+)"
)


def registry():
    """Every `hex settings` key with its kind, from the Rust sources."""
    sources = [ROOT / "src/control/settings.rs"]
    sources += sorted((ROOT / "src/control/settings").glob("*.rs"))
    keys = {}
    for source in sources:
        for match in KEY_CALL.finditer(source.read_text()):
            keys.setdefault(match.group(1), match.group(3) or "Number")
    return keys


def at(settings, key):
    """The value at a dotted key, or None."""
    value = settings
    for part in key.split("."):
        if not isinstance(value, dict) or part not in value:
            return None
        value = value[part]
    return value


def wanted(key, kind):
    if DENIED.search(key):
        return None
    if key.startswith("labs.") and kind == "Bool" and key not in LABS_STATE:
        return "settings"
    if key in ALLOWED:
        return "settings"
    if kind == "Shortcut" or key in SHORTCUT_MODES:
        return "shortcuts"
    return None


def vocabulary(settings):
    terms = []
    for entry in settings.get("vocabulary") or []:
        if isinstance(entry, str):
            entry = {"term": entry}
        if not isinstance(entry, dict) or not str(entry.get("term", "")).strip():
            continue
        term = {"term": str(entry["term"]).strip()}
        heard = [str(s).strip() for s in entry.get("sounds_like") or [] if str(s).strip()]
        if heard:
            term["sounds_like"] = heard
        terms.append(term)
    return terms


def export(settings, keys=None):
    keys = keys if keys is not None else registry()
    preset = {"settings": {}, "shortcuts": {}}
    for key, kind in sorted(keys.items()):
        part = wanted(key, kind)
        value = at(settings, key)
        if part and value is not None:
            preset[part][key] = value
    processing = at(settings, "dictation_processing.default_mode.post_processing") or {}
    if isinstance(processing.get("enabled"), bool):
        preset["settings"]["dictation_processing.default_mode.cleanup"] = processing["enabled"]
    prompt = processing.get("prompt")
    if isinstance(prompt, str) and prompt.strip():
        preset["prompt"] = prompt
    preset["vocabulary"] = vocabulary(settings)
    return preset


def main(argv):
    source = pathlib.Path(argv[1]) if len(argv) > 1 else DEFAULT_SETTINGS
    out = pathlib.Path(argv[2]) if len(argv) > 2 else DEFAULT_OUT
    preset = export(json.loads(source.read_text()))
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(preset, ensure_ascii=False, indent=2) + "\n")
    print(f"{out}: {len(preset['settings'])} settings, {len(preset['shortcuts'])} shortcut keys, "
          f"{len(preset['vocabulary'])} terms, prompt {'yes' if 'prompt' in preset else 'no'}")
    for part in ("settings", "shortcuts"):
        print(f"{part}: " + ", ".join(preset[part]))


if __name__ == "__main__":
    main(sys.argv)
